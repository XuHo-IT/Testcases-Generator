# Copy to .env.local and fill in the providers you actually use.
# Every key is read server-side only and is never sent to the browser.
# Configure at least one provider (or the mock) for the app to be usable.

# --- Anthropic Claude ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Google Gemini ---
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Ollama (local models, on-prem) ---
# Leave empty to hide local models. With docker-compose use http://ollama:11434
OLLAMA_BASE_URL=

# --- Offline mock provider ---
# Set to 1 to expose a fixture-backed model — the whole flow runs with no API
# calls and no cost. Useful for demos, development and CI.
ENABLE_MOCK_PROVIDER=0
